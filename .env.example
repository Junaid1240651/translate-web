# JWT
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=7d

# Database: Supabase (PostgreSQL)
# From Supabase: Project Settings → Database → Connection string (URI)
# Use Transaction pooler (port 6543) for serverless; direct (5432) for local dev.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_SSL=true

# Email / OTP
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Video Translator <noreply@yourdomain.com>"

# Contact form admin inbox (optional; falls back to SMTP_USER when unset)
# CONTACT_ALERT_EMAIL=support@yourdomain.com

# Razorpay payments
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# RAZORPAY_KEY_SECRET=your_razorpay_secret
